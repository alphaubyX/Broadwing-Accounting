# Broadwing Accounting settings.
# Save this file as /home/YOUR-CPANEL-USER/broadwing-accounting.env
# (your home folder, NOT inside public_html or the website folder).

# MySQL: mysql://USER:PASSWORD@localhost:3306/DATABASE (full names, with your cPanel prefix)
DATABASE_URL=mysql://cpaneluser_dbuser:password@localhost:3306/cpaneluser_broadwing

# Password for opening the app (sign in with user "admin" unless APP_USERNAME is set)
APP_PASSWORD=choose-a-long-password

# Where logos and receipts are stored (outside the website folder)
UPLOAD_DIR=/home/cpaneluser/broadwing-accounting-uploads
