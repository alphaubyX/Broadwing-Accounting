{
  "private": true,
  "description": "Front-end build tools only (development). The server never needs Node.js.",
  "scripts": {
    "build:css": "tailwindcss -i resources/css/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i resources/css/app.css -o public/css/app.css --watch",
    "vendor:js": "node -e \"require('fs').copyFileSync('node_modules/alpinejs/dist/cdn.min.js','public/js/alpine.min.js')\"",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "alpinejs": "3.14.9",
    "tailwindcss": "3.4.17"
  }
}
