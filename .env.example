# MySQL / MariaDB connection string:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
# (URL-encode special characters in the password, e.g. @ → %40)
DATABASE_URL="mysql://broadwing:broadwing@localhost:3306/broadwing_accounting"

# Where uploaded logos and receipts are stored (local disk for now)
UPLOAD_DIR="./uploads"

# Optional: protect the whole app with a password (until Broadwing sign-in exists)
# APP_USERNAME="admin"
# APP_PASSWORD="choose-a-strong-password"
