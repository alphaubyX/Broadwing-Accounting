APP_NAME="Broadwing Accounting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Set by the installer (first visit). APP_INSTALLED=true locks the installer.
APP_INSTALLED=false
# Hash of the password that protects the app (set by the installer / Settings).
APP_PASSWORD_HASH=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Files and sessions are kept on disk: no extra services needed on shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
